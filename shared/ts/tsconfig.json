{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // `secrets/patterns.ts` reads the Lua pattern list off disk via
    // `import.meta.dir`, which is a Bun extension and not on the standard
    // `ImportMeta`. Without this, including `secrets/` is the one thing in the
    // widened set that does not compile.
    "types": ["bun"],
    "moduleResolution": "bundler",
    "jsx": "preserve",
    // Solid 2: solid-js no longer ships `solid-js/jsx-runtime`. The renderer
    // package owns the JSX types, so this has to name @solidjs/web — the same
    // value tWeb, web-next, portfolio-next, ha-dash and tCAD all carry.
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "paths": {
      "@tlib/shared": ["./index.ts"],
      "@tlib/shared/*": ["./*"]
    }
  },
  // The JSX surface and what it pulls in. This package has no build of its own —
  // consumers compile it — so the roots are named here deliberately rather than
  // globbing the directory: `build/` is Bun tooling, `rage*/scripts/` are CLI
  // verifiers, and both have their own tsconfigs and their own runtime types.
  //
  // `solid-compat/` is excluded on purpose and must stay excluded: it is the
  // vendor-import shim, it is REQUIRED to keep naming the Solid 1 surface, and
  // it resolves through a `virtual:` specifier that only exists inside Vite.
  "include": [
    "env.d.ts",
    "solid-1-compat-jsx.d.ts",
    "admin-ui/**/*.ts",
    "admin-ui/**/*.tsx",
    "marketplace/**/*.ts",
    "marketplace/**/*.tsx",
    "nui-kit/**/*.ts",
    "nui-kit/**/*.tsx",
    "prop-editor/**/*.ts",
    "prop-editor/**/*.tsx",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    // Not optional. `telemetry/` was reachable
    // from this config only through `nui.ts -> telemetry/ambient.ts`, so tsc
    // followed that ONE leaf and checked nothing else in the directory —
    // `collect.ts`, `payload.ts`, `session.ts` and the rest were never looked
    // at, and `typecheck:shared` reported EXIT 0 while a barrel in there still
    // exported five symbols that no longer existed. A pass over a file set that
    // does not contain the code is worse than no pass: it is a green light.
    "telemetry/**/*.ts",
    // Added for the same reason the telemetry note above describes. These nine
    // directories were covered by nothing: a comment pass broke block
    // delimiters in deck/card.ts, deck/strip.ts and build/deck-pack.ts and this
    // config reported EXIT 0 on all three. Only biome's parse stage found them.
    "assets/**/*.ts",
    "audio/**/*.ts",
    "build/**/*.ts",
    "audio3d/**/*.ts",
    "deck/**/*.ts",
    "fs/**/*.ts",
    "gizmo/**/*.ts",
    "modules/**/*.ts",
    "secrets/**/*.ts",
    "cn.ts"
  ],
  // `*.test.ts` is excluded: those run under `bun test`, which supplies `bun:test`
  // and the `Bun` global. Pulling them in here would mean adding `types: ["bun"]`
  // to a config whose whole job is to check browser code against Solid 2.
  "exclude": ["node_modules", "dist", "solid-compat", "**/*.test.ts", "**/*.test.tsx"]
}
