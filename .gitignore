node_modules/

# Generated output. One root, so a new build artifact never needs a new rule
# here and can never reach a release by being forgotten.
.build/

# Fetched at setup, never authored.
.runtime/

# Built artefacts that must sit at a path the manifest names, so they cannot
# live under .build/: FiveM resolves ui_page and server_scripts from the
# resource root.
client/ui/
server/dist/

# Pre-migration output paths. Remove once nothing writes to them.
dist/
*.zip

# The workshop: reference material and sources used to make what ships.
/assets/

# Private tooling. internal/ is the provenance engine: its own git repository,
# nested here so the consumers that use it sit beside it, and ignored so it can
# never reach this public MIT repo. Nesting is the real guard, not this line --
# git add -f on a directory containing .git records a gitlink, not the contents,
# and git clean -xdf leaves a nested repo alone. tests/unit/private-not-tracked.test.ts
# asserts both.
/internal/

# The obfuscator used to sit at this path, hidden only by this rule; the rule stays
# as a tripwire so a copy that drifts back can never be committed.
shared/ts/build/obfuscate.ts

# Local state and notes.
data.json
docs/todo.md
CLAUDE.md
.claude/
docs/internal/

# Config exports that could not be written into their target resource. Runtime
# output for the operator to copy by hand, one directory per target — never
# source. See "Exporting a config into another resource" in docs/content/exports.mdx.
export-staging/

# Secrets.
.env
.env.local
.env.*.local

# Logs and editor/OS noise.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
.cache/
.vite/
.tmp/
