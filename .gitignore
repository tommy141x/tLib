node_modules/

# Generated output. One root, so a new build artifact never needs a new rule
# here and can never reach a release by being forgotten.
.build/

# Fetched at setup, never authored.
.runtime/

# Built artefacts that must sit at a path the manifest names, so they cannot
# live under .build/: FiveM resolves ui_page and server_scripts from the
# resource root.
client/ui/
server/dist/

# Pre-migration output paths. Remove once nothing writes to them.
dist/
*.zip

# The workshop: reference material and sources used to make what ships.
/assets/

# Private tooling. tLib is a public MIT repo -- the obfuscator is consumed from
# here by the closed resources but is not published with it.
shared/ts/build/obfuscate.ts

# Local state and notes.
data.json
docs/todo.md
CLAUDE.md
.claude/
docs/internal/

# Secrets.
.env
.env.local
.env.*.local

# Logs and editor/OS noise.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
.cache/
.vite/
.tmp/
