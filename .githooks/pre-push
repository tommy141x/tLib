#!/bin/sh
# Refuses to publish private paths to a public remote.
#
# tLib is published to GitHub and developed on Gitea. The private half —
# internal/, and the .gitea/ workflows that name the private org — lives on a
# Gitea-only branch. Nothing enforces that but this hook and branch discipline.
#
# This replaced a STRUCTURAL guard, and that is why it exists. internal/ used to
# be a nested repository of its own: `git add -f` on it recorded a gitlink
# rather than its contents, and `git clean -xdf` skipped it entirely. As
# ordinary tracked content on a branch it has neither property, so one merge of
# the private branch into a published one puts the code in the public object
# database permanently — a revert does not remove it, only a history purge does.
#
# TWO CHECKS, AND NEITHER IS "every tree in the range".
#
#   1. The TIP TREE of each pushed ref — the state being published.
#   2. Paths ADDED anywhere in the pushed range — catches add-then-remove, where
#      the tip is clean but the blob still ships inside the history.
#
# Scanning every tree instead was the first version and it is unusable here:
# `.gitea/` is already present in commits that are already on GitHub, so that
# check refused every push forever. A gate that must be bypassed to work is not
# a gate, and the one that cries wolf is the one that gets --no-verify'd. The
# job is to stop `.gitea/` coming BACK and to stop `internal/` ever arriving.
#
# Bypass with --no-verify only if you can say which commit you checked by hand.

remote_url="$2"

case "$remote_url" in
  *github.com*) ;;
  *) exit 0 ;;   # Gitea and anything else: the private branch belongs there.
esac

PRIVATE='^(internal/|\.gitea/)'
ZERO='0000000000000000000000000000000000000000'

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue    # branch deletion

  # 1. What this push makes the public state.
  tip=$(git ls-tree -r --name-only "$local_sha" | grep -E "$PRIVATE" | sort -u)

  # 2. What this push introduces along the way.
  if [ "$remote_sha" = "$ZERO" ]; then
    added=""                                # new branch: the tip check covers it
  else
    added=$(git diff --name-only --diff-filter=A "$remote_sha..$local_sha" \
      | grep -E "$PRIVATE" | sort -u)
  fi

  hits=$(printf '%s\n%s\n' "$tip" "$added" | grep -v '^$' | sort -u)

  if [ -n "$hits" ]; then
    echo "pre-push: REFUSED. Private paths bound for $remote_url:" >&2
    echo "$hits" | sed 's/^/    /' >&2
    echo "" >&2
    echo "  internal/ and .gitea/ belong on the Gitea-only branch. If one of these" >&2
    echo "  reaches a published branch, a revert is not enough — the blob stays in" >&2
    echo "  the object database and the history has to be rewritten." >&2
    status=1
  fi
done

exit $status
