{
  "name": "tlib",
  "version": "0.12.0",
  "license": "MIT",
  "private": true,
  "description": "Shared UI and utility library for FiveM resources",
  "scripts": {
    "build": "cd client/web && bun run build",
    "dev": "cd client/web && bunx vp dev",
    "prod": "bun run scripts/prod.ts",
    "gallery": "bun run scripts/gallery.ts",
    "setup": "bun install && cd client/web && bun install",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "bun test",
    "test:lua": "bun run scripts/test-lua.ts",
    "typecheck": "bunx tsc --noEmit -p client/web/tsconfig.json",
    "typecheck:shared": "cd shared/ts && bunx tsc --noEmit -p tsconfig.json",
    "check:imports": "bun run scripts/check-relative-imports.ts",
    "scan:solid2": "bun run scripts/solid2-scan.ts",
    "check:regression": "bun run typecheck && bun run check:imports && bun run test && bun run test:lua",
    "verify": "bun run lint && bun run check:regression && bun run build"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/adm-zip": "^0.5.8",
    "@types/ws": "^8.18.1",
    "adm-zip": "^0.6.1"
  }
}
